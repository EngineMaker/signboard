# signboard configuration
# Copy to .env and fill in. Never commit .env (it is gitignored).

PORT=3100
DB_PATH=data/signboard.sqlite

# Public base URL. Used to build the OAuth redirect URI.
# Production: https://signboard.emaker.dev
BASE_URL=http://localhost:3100

# --- Discord ---
# From https://discord.com/developers/applications
# CLIENT_SECRET and BOT_TOKEN are secrets. Do not share or paste them anywhere.

# OAuth2 tab -> Client ID (same as Application ID; public value)
DISCORD_CLIENT_ID=
# OAuth2 tab -> Reset Secret
DISCORD_CLIENT_SECRET=
# Bot tab -> Reset Token
DISCORD_BOT_TOKEN=
# Right-click the server name in Discord -> Copy Server ID (needs Developer Mode)
DISCORD_GUILD_ID=
# Server Settings -> Roles -> right-click the resident role -> Copy Role ID
DISCORD_RESIDENT_ROLE_ID=

# Signing key for session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Set to 1 to run the web server without the Discord bot.
# DISABLE_BOT=1
