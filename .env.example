# アプリ
PORT=3100
DB_PATH=data/signboard.sqlite

# 外部に見えるベースURL。OAuth のリダイレクト先の組み立てに使う。
# 本番では https://signboard.emaker.dev
BASE_URL=http://localhost:3100

# --- Discord ---
# Developer Portal (https://discord.com/developers/applications) で取得する。
# CLIENT_SECRET と BOT_TOKEN は秘密。このファイルの実体 (.env) はコミットしないこと。

# OAuth2 タブ → Client ID（アプリIDと同じ値。公開値）
DISCORD_CLIENT_ID=
# OAuth2 タブ → Reset Secret
DISCORD_CLIENT_SECRET=
# Bot タブ → Reset Token
DISCORD_BOT_TOKEN=
# Discord でサーバー名を右クリック → IDをコピー（要: 開発者モード）
DISCORD_GUILD_ID=
# サーバー設定 → ロール → EM住民を右クリック → IDをコピー
DISCORD_RESIDENT_ROLE_ID=

# セッション Cookie の署名鍵。`openssl rand -hex 32` で生成する。
SESSION_SECRET=
