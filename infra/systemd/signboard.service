# signboard を systemd の user unit として常駐させる。
# user unit にすることで sudo なしで導入・更新できる（SPEC §2.8: sudo はパスワード必須）。
#
# 配置先: ~/.config/systemd/user/signboard.service
# 有効化: systemctl --user enable --now signboard
# ログ:   journalctl --user -u signboard -f

[Unit]
Description=signboard - シェアハウスの電光掲示板
Documentation=https://github.com/EngineMaker/signboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/signboard

# .env は node 側の --env-file-if-exists が読む（下の ExecStart）。
# systemd の EnvironmentFile は使わない。値に # や引用符が入ったときの
# 解釈が node と systemd で違い、片方だけ壊れる事故を避けるため。

# node の場所は環境で変わる（mise / nvm / apt など）。systemd は対話シェルの
# PATH を引き継がず、かつ ExecStart の「コマンド本体」には環境変数を展開しない
# （${VAR} を書くと 203/EXEC になる）。そのため setup.sh がこの行を
# 検出した絶対パスで書き換えてから配置する。@NODE_BIN@ はその差し込み口。
#
# 直接 systemctl --user edit で書き換えず、setup.sh を流し直すこと。
ExecStart=@NODE_BIN@ --env-file-if-exists=.env --experimental-strip-types src/server.ts

# 落ちたら起こし直す。掲示板は常時表示が前提のため。
Restart=always
RestartSec=5

# 起動に繰り返し失敗しても諦めない（サーバー再起動直後にネットワークが
# 整わず失敗することがあるため、回数制限を緩めておく）
StartLimitBurst=10
StartLimitIntervalSec=120

# SIGTERM で Bot の切断と DB のクローズを行う（src/server.ts の shutdown）
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=signboard

# 最低限の保護。user unit なので効く範囲は限られるが、入れておいて損はない。
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
