# signboard を systemd の user unit として常駐させる。
# user unit にすることで sudo なしで導入・更新できる（SPEC §2.8: sudo はパスワード必須）。
#
# 配置先: ~/.config/systemd/user/signboard.service
# 有効化: systemctl --user enable --now signboard
# ログ:   journalctl --user -u signboard -f

[Unit]
Description=signboard - シェアハウスの電光掲示板
Documentation=https://github.com/EngineMaker/signboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/signboard

# node の場所は環境で変わる（mise / nvm / apt など）。
# systemd は対話シェルの PATH を引き継がないため、setup.sh が実行時に
# 検出した絶対パスを %h/.config/systemd/user/signboard.env に書き出す。
# ここが古い node を指すと --experimental-strip-types が使えず起動に失敗する。
EnvironmentFile=%h/.config/systemd/user/signboard.env
ExecStart=${NODE_BIN} --env-file-if-exists=.env --experimental-strip-types src/server.ts

# 落ちたら起こし直す。掲示板は常時表示が前提のため。
Restart=always
RestartSec=5

# 起動に繰り返し失敗しても諦めない（サーバー再起動直後にネットワークが
# 整わず失敗することがあるため、回数制限を緩めておく）
StartLimitBurst=10
StartLimitIntervalSec=120

# SIGTERM で Bot の切断と DB のクローズを行う（src/server.ts の shutdown）
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=signboard

# 最低限の保護。user unit なので効く範囲は限られるが、入れておいて損はない。
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
