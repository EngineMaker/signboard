# Cloudflare Tunnel を systemd の user unit として常駐させる。
# 配置先: ~/.config/systemd/user/signboard-tunnel.service
#
# cloudflared の場所は環境で変わるため（apt 版は /usr/bin、
# バイナリ配置なら ~/.local/bin）、PATH から探させる。

[Unit]
Description=Cloudflare Tunnel for signboard
Documentation=https://github.com/EngineMaker/signboard
After=network-online.target signboard.service
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env cloudflared tunnel --config %h/.cloudflared/config.yml run
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=signboard-tunnel

[Install]
WantedBy=default.target
